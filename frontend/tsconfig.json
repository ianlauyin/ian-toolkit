{
    "compilerOptions": {
        "target": "ES2023",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "preserve",
        "jsxImportSource": "@solidjs/web",
        "lib": ["ES2023", "DOM"],
        "strict": true,
        "noEmit": true,
        "isolatedModules": true,
        "skipLibCheck": true,
        "types": ["vite/client", "node"],
        "verbatimModuleSyntax": true,
        "paths": {
            "component/*": ["./src/component/*"],
            "util/*": ["./src/util/*"],
            "module/*": ["./src/module/*"]
        }
    },
    "include": ["src", "tests"]
}
